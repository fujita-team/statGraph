> 
> ### Name: graph.acf
> ### Title: Auto Correlation Function Estimation for Graphs
> ### Aliases: graph.acf
> ### Keywords: autocorrelation
> 
> ### ** Examples
> 
> set.seed(1)
> G <- list()
> p <- array(0, 100)
> p[1:3] <- rnorm(3)
> for (t in 4:100) {
+   p[t] <- 0.5*p[t-3] + rnorm(1)
+ }
> ma <- max(p)
> mi <- min(p)
> p <- (p - mi)/(ma-mi)
> for (t in 1:100) {
+   G[[t]] <- igraph::sample_gnp(100, p[t])
+ }
> graph.acf(G, plot=TRUE)

