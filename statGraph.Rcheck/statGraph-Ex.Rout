> ### Name: graph.hclust
> ### Title: Hierarchical cluster analysis on a list of graphs.
> ### Aliases: graph.hclust
> ### Keywords: clustering
> 
> ### ** Examples
> 
> set.seed(1)
> G <- list()
> for (i in 1:5) {
+   G[[i]] <- igraph::sample_gnp(50, 0.5)
+ }
> for (i in 6:10) {
+   G[[i]] <- igraph::sample_smallworld(1, 50, 8, 0.2)
+ }
> for (i in 11:15) {
+   G[[i]] <- igraph::sample_pa(50, power = 1, directed = FALSE)
+ }
> graph.hclust(G, 3)
